# 复制为仓库根目录 .env 使用（不要提交到 Git）
# 数据库 / 缓存密码
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis
# RAG 问答的 LLM 密钥（可选，不启用 RAG 问答可留空）
RAG_LLM_API_KEY=
# ghcr.io 镜像拉取凭据（可选；设置后 apply.sh 会自动创建 imagePullSecret）
# GITHUB_USER=你的GitHub用户名
# GITHUB_PAT=ghp_xxx（需要 read:packages 权限的 Personal Access Token）
